# ─────────────────────────────────────────────────────────────────────────────
# TourBuddy on InfinityFree (free hosting) — copy these lines into a NEW file named ".env"
# on the server (File Manager → htdocs → New File → ".env"), then fill in the values.
# Never upload the .env from your own computer, and never share this file filled in.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
APP_DEBUG=false

# Your public address. Use http:// until the free SSL certificate is issued, then change it to https://
APP_URL=https://tourbuddy.kesug.com

# ── Database (InfinityFree → MySQL Databases) ───────────────────────────────
# DB_HOST is shown in the panel and looks like sql123.infinityfree.com — it is NOT "localhost".
# DB_NAME looks like if0_12345678_tms, DB_USER like if0_12345678, DB_PASS is your hosting/account password
# (or the one you set for the database user).
DB_HOST=sqlXXX.infinityfree.com
DB_NAME=if0_XXXXXXXX_tms
DB_USER=if0_XXXXXXXX
DB_PASS=

# ── Schema upkeep ────────────────────────────────────────────────────────────
# InfinityFree gives you no command line, so you cannot run "php database/migrate.php". Keeping this at 1 lets the
# site create any missing table/column by itself the first time a page loads (safe to repeat, adds only).
# It is also what creates the first admin account (see below). With APP_ENV=production the default would be off,
# so it is set explicitly here.
TMS_AUTO_SCHEMA=1

# ── First admin account (only used while the admin table is EMPTY) ──────────
# On the first page load after TMS_AUTO_SCHEMA=1 runs, if no admin exists the site creates one:
#   username: admin     password: the value below (minimum 12 characters, else nothing is created)
# Sign in at /admin/ , then REMOVE this line from .env (the password hash is stored in the database).
TMS_BOOTSTRAP_ADMIN_PASSWORD=

# ── Payments: DEMO ONLY ──────────────────────────────────────────────────────
# No payment gateway is configured. The built-in "sandbox" payment moves NO money. In production mode it is
# refused unless you switch it on explicitly, so a demo site would not be able to confirm bookings.
# Remove this line (or set 0) the day you connect a real gateway.
TMS_ALLOW_SANDBOX_PAYMENTS=1

# ── AI ───────────────────────────────────────────────────────────────────────
# InfinityFree cannot reach a local Ollama and may block calls to outside AI services. "none" turns AI off cleanly:
# chat and Explore then answer from the catalogue, with a short note. (Valid values: auto, ollama, gemini, openai, none.)
AI_PROVIDER=none

# ── Secrets for encryption (generate your own, hex characters 0-9 a-f only, 64 characters each) ──
# Any online password generator that can make "hex" strings will do. Use DIFFERENT values for each, keep them
# private, and do not change them later or existing encrypted data becomes unreadable.
WALLET_ENCRYPTION_KEY=
TMS_2FA_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# A contact address sent in the User-Agent to OpenStreetMap services (their usage policy asks for one).
MAP_CONTACT_EMAIL=
# 16+ characters. Lets you open /health.php with the header X-Health-Token for detail. Leave empty for up/down only.
HEALTH_TOKEN=
