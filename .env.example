# ─────────────────────────────────────────────────────────────────────────────
# TourBuddy environment configuration
#
# HOW TO USE: copy this file to ".env" in this same folder and fill in the keys
# you have. Everything here is OPTIONAL except GEMINI_API_KEY — without that one
# every AI feature (chatbot, AI Recommender, AI Planner, Explore Mode overview,
# packing assistant, image analyzer) silently falls back to canned, non-AI text.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS/Linux)
#
# .env is ignored by git and blocked from the web by .htaccess — never commit it.
# ────────────────────────────────────────────────────────────────────────────

# ── Payments (all optional -- sandbox is used automatically until these are set) ──
# PaymentService always uses the built-in Sandbox provider (no real money,
# clearly labeled everywhere) unless a real provider below has ALL of its
# required keys filled in. Leaving everything blank is completely safe and
# is the current, honest state of this project (no merchant account with
# any of these providers exists yet). See PAYMENTS.md before filling these in.
PAYMENT_PROVIDER=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_LIVE=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_LIVE=false

# ── Database (REQUIRED on every host except local XAMPP) ─────────────────────
# Leave all four blank to keep using local XAMPP defaults (localhost / root /
# no password / "tms"). Any real host (shared hosting, a VPS, Oracle Cloud...)
# will give you its own MySQL host, database name, username and password —
# put those here. This is the ONLY thing that has to change to move this app
# from your computer to a live server; nothing else in the code is
# environment-specific.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# ── AI (REQUIRED for every AI feature) ─────────────────────────────────
# Free key, no credit card: https://aistudio.google.com  →  "Get API key"
# A valid key starts with "AIza".
GEMINI_API_KEY=AQ.Ab8RN6LPb4RHBCBjcb4z1G5ul3jjOvL5Bi6ah1t3HnZ2bybcDg
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_TOKENS=2000
AI_CACHE_TTL=3600
AI_RATE_LIMIT=30

# ── Weather (OPTIONAL) ───────────────────────────────────────────────────────
# Leave blank and the site uses Open-Meteo, which is free and needs no key.
# Setting this switches the Weather page to OpenWeatherMap instead.
# Free key: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=1ad082a4be2dd59f81497da6ceb79aec
WEATHER_CACHE_TTL=1800

# ── Maps / Places (OPTIONAL) ─────────────────────────────────────────────────
# Explore Mode works fully without these using OpenStreetMap, Overpass and OSRM.
# A Google key adds public-transport directions and richer place photos.
GOOGLE_MAPS_API_KEY=AIzaSyDAKDXjPH5KJu70BMkBgCe7JW-GTh8vtvI
GOOGLE_PLACES_API_KEY=

# ── Outgoing email (OPTIONAL) ────────────────────────────────────────────────
# With SMTP_HOST blank, the site does not send mail at all — booking
# confirmations and password resets are written to the log instead of delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=TourBuddy Travel

# ── Wallet document encryption (REQUIRED for Travel Wallet uploads) ─────────
# AES-256-GCM key for encrypting uploaded passport/visa/ID scans at rest
# (Round 86, master prompt item 28). Without it, wallet.php refuses new
# uploads rather than storing one unencrypted. Generate a real value with:
# php -r "echo bin2hex(random_bytes(32));"
WALLET_ENCRYPTION_KEY=8ec81a7b42e96db411704f400720767ea4f0b3c2f2d22c4086ee43fca81d5ea5

# ── App ──────────────────────────────────────────────────────────────────────
# APP_DEBUG controls whether raw PHP errors/warnings are printed into the
# page (and into JSON API responses, which breaks them) -- see
# backend/config.php's "Debug/error-display wiring" block (Round 115).
# Defaults to false here because .env.example is the TEMPLATE new
# environments (including production/staging) are copied from -- it should
# never be true anywhere public. Set it to true only in your own local
# development .env, never in a shared or deployed one.
APP_DEBUG=false

# ── Self-hosted AI (no external LLM API) ─────────────────────────────
# AI_PROVIDER: auto (default when unset) | ollama | gemini | openai | none
#   auto   = local Ollama (https://ollama.com) when it is running with a chat model installed; otherwise Gemini ONLY if
#            GEMINI_API_KEY is a real Google AI Studio key (AIza + 35 characters); otherwise no AI at all. When there is no
#            AI, chat, Explore and search still answer from the catalogue - customers see no error, just no free-form text.
#   ollama = always use local Ollama.   none = turn AI off.   gemini/openai = send customer text to that vendor.
# Check what is selected and why:  php scripts/ai_setup_check.php --test     (or admin > AI Setup & Test)
# Keep OLLAMA_BASE_URL on localhost/private network; never expose it publicly.
# AI_PROVIDER=auto
# Local model speed: cap on tokens per answer and how long Ollama keeps the model in memory.
# OLLAMA_MAX_TOKENS=1536
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct

# Demo content: set to 1 ONLY on a dev/demo install to (re)create ~400 generated sample
# tour packages from data/packages_seed.json. Leave unset on a real site.
# TMS_SEED_SAMPLE_PACKAGES=1

# Capability-based model routing (all optional; each falls back to OLLAMA_MODEL). Pick models from the output of
# `php scripts/ai_benchmark.php` rather than assuming bigger is better. A model that is not installed is skipped.
# AI_MODEL_FAST=qwen2.5:1.5b-instruct     # intent classification / query interpretation
# AI_MODEL_CHAT=qwen2.5:3b-instruct       # conversational assistant
# AI_MODEL_PLAN=qwen2.5:7b-instruct       # itinerary planning

# Optional: semantic re-ranking of assistant package search (needs Ollama; off when empty).
# AI_EMBED_MODEL=nomic-embed-text
# With a model set, run `php scripts/sync_embeddings.php` (or use the button on the admin AI dashboard) to store vectors for the
# whole catalogue; search then combines keyword + meaning (hybrid). Until at least 80% of packages are indexed it stays keyword-only.
# nomic-embed-text is mostly English; for Bengali questions use a multilingual embedding model (for example bge-m3) - not verified here.
# AI_EMBED_MIN_SIM=0.5

# --- AI provider failover (optional, off by default) ---------------------------------------------
# When AI_PROVIDER is down, try these in order. "ollama" is local (data stays on your machine).
# Another cloud vendor (openai/gemini) is only used if AI_FALLBACK_ALLOW_EXTERNAL=1, because chat text would be sent to it.
# AI_FALLBACK_PROVIDERS=ollama
# AI_FALLBACK_ALLOW_EXTERNAL=0

# Per-hour AI limits (database-backed; guests are counted by REMOTE_ADDR). Defaults: 60 per guest address, 300 per account.
# AI_GUEST_IP_HOURLY=60
# AI_USER_HOURLY=300
# Seconds to cache identical guest chat answers (0 disables, max 3600).
# AI_CHAT_CACHE_TTL=600

# Google sign-in (see GOOGLE_LOGIN.md). Leave empty to hide the button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# ── Stage 17: sessions and 2FA ──────────────────────────────────────────────
# Idle / absolute session limits (0 disables a limit). Defaults shown.
SESSION_IDLE_MINUTES=120
SESSION_ADMIN_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=24
# Encrypts stored 2FA secrets (AES-256-GCM). 16+ random characters. KEEP IT: losing it locks 2FA users out.
# After setting it run:  php scripts/encrypt_2fa_secrets.php --apply   (new setups are encrypted automatically)
TMS_2FA_KEY=

# Schema setup/repair inside web requests. 1 = run automatically (development default), 0 = never from a web
# request; run `php database/migrate.php` on every deploy instead. Unset: on, except when APP_ENV=production.
# TMS_AUTO_SCHEMA=0

# Minutes after which a pending, unpaid booking is cancelled by scripts/expire_pending_bookings.php --apply
# (releases its seats). Empty/0 = never expire. Minimum effective value is 10.
TMS_BOOKING_HOLD_MINUTES=

# Optional: shared secret (16+ chars) that unlocks the detailed /health.php view when sent as the X-Health-Token header.
# Without it the public endpoint only reports {"status":"ok"} / "down".
HEALTH_TOKEN=

# Set to 1 to time every page: adds a Server-Timing header (Chrome DevTools > Network > Timing) and one
# "[TourBuddy Profile] ..." line per page to the PHP error log. Leave off in production unless you are measuring.
# TMS_PROFILE=1

# Public contact details shown on the Contact page, header and footer. Anything left empty is simply not shown
# (the site never invents an address or email). TMS_OFFICE_LAT / TMS_OFFICE_LNG add a map to the Contact page.
# TMS_SUPPORT_PHONE=+880 1XXX-XXXXXX
# TMS_SUPPORT_EMAIL=support@your-domain
# TMS_OFFICE_ADDRESS=
# TMS_OFFICE_LAT=
# TMS_OFFICE_LNG=

# ── App ──────────────────────────────────────────────────────────────────────
# APP_DEBUG controls whether raw PHP errors/warnings are printed into the
# page (and into JSON API responses, which breaks them) -- see
# backend/config.php's "Debug/error-display wiring" block (Round 115).
# Defaults to false here because .env.example is the TEMPLATE new
# environments (including production/staging) are copied from -- it should
# never be true anywhere public. Set it to true only in your own local
# development .env, never in a shared or deployed one.
APP_DEBUG=true

# ── Self-hosted AI (no external LLM API) ─────────────────────────────
 Set AI_PROVIDER=ollama to use a local Ollama runtime (https://ollama.com).
 Keep OLLAMA_BASE_URL on localhost/private network; never expose it publicly.
 AI_PROVIDER=ollama
 OLLAMA_BASE_URL=http://127.0.0.1:11434
 OLLAMA_MODEL=qwen2.5:3b-instruct

# Demo content: set to 1 ONLY on a dev/demo install to (re)create ~400 generated sample
# tour packages from data/packages_seed.json. Leave unset on a real site.
 TMS_SEED_SAMPLE_PACKAGES=1
