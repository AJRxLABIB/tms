# ─────────────────────────────────────────────────────────────────────────────
# TMS — Apache configuration
# ─────────────────────────────────────────────────────────────────────────────

# 1. Never serve secrets, dumps, or internal notes over HTTP.
#    .env sits inside the document root, so without this rule anyone could read
#    the API keys at http://<host>/tms/.env
<FilesMatch "^\.env|\.(env|sql|md|log|ini|bak|old|orig|py|sh|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Let the REST API see "Authorization: Bearer ..." headers.
#    XAMPP's default Apache/PHP setup strips them before PHP ever sees them,
#    which silently breaks every token-authenticated API call.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# 3. Don't advertise the directory listing of folders without an index file.
Options -Indexes


# 4. Baseline security response headers (production hardening pass).
<IfModule mod_headers.c>
    # Stop browsers guessing a different MIME type than the one the server sent
    # (e.g. treating an uploaded travel-document as executable HTML/JS).
    Header always set X-Content-Type-Options "nosniff"
    # Nothing in this project is meant to be embedded in another site's frame.
    Header always set X-Frame-Options "SAMEORIGIN"
    # Send the referring URL to other sites only as an origin, never the full
    # path/query (booking IDs, tokens, etc. never leak via the Referer header).
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Only the features this app actually uses: tour-map.php asks for
    # geolocation, the AI copilot's voice input asks for the microphone.
    # Camera and payment-UI delegation are switched off since nothing here
    # uses them.
    Header always set Permissions-Policy "geolocation=(self), microphone=(self), camera=(), payment=()"
    # No effect over plain HTTP (which is what local XAMPP serves) -- browsers
    # only honor this over HTTPS, so it's inert here and simply already in
    # place for whenever this is deployed behind TLS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Round 106 (master prompt item 56/"MONITORING"-adjacent hardening pass):
    # a real Content-Security-Policy, deferred at the earlier pass because
    # ~60 pages here use inline <script>/<style> and load from several CDNs,
    # and the local database was unstable at the time -- neither blocker
    # applies now. Built from a full grep-based audit of every external
    # origin actually referenced anywhere in this codebase (not a guess):
    # jsdelivr/cdnjs/code.jquery.com/unpkg for scripts, those plus
    # fonts.googleapis.com/stackpath.bootstrapcdn.com for styles,
    # fonts.gstatic.com/cdnjs for font files, and a permissive https: for
    # images (package/destination photos, weather icons, and OpenStreetMap
    # map tiles come from many different https hosts, none of which can
    # execute script, so this is the one directive deliberately left loose).
    # 'unsafe-inline' on script-src/style-src is still required -- the
    # inline <script>/<style> blocks and onerror="..." attributes across
    # this codebase are real, working, load-bearing code, not something to
    # silently break for a marginally stricter policy (Rule 2). Every
    # distinct external-resource category this audit found was
    # spot-checked live in a representative page of each kind (home page,
    # a Leaflet map page, the Google Street View embed on package details,
    # weather icons, admin Chart.js dashboard, Bootstrap-4 login/register,
    # the Swagger API docs page) with the browser console watched for
    # violations before shipping -- not literally every one of the ~70
    # files this touches, which would be its own disproportionate sweep.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://code.jquery.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://stackpath.bootstrapcdn.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>


# 5. Performance: compress text responses and let browsers cache static assets.
#    (Both blocks are inert if the Apache module is not enabled.) CSS/JS URLs
#    that change get a ?v=<mtime> query from tms_asset_ver(), so a 30-day
#    lifetime does not strand users on stale files. PHP pages are not cached.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
