# ─────────────────────────────────────────────────────────────────────────────
# TMS environment configuration
#
# HOW TO USE: copy this file to ".env" in this same folder and fill in the keys
# you have. Everything here is OPTIONAL except GEMINI_API_KEY — without that one
# every AI feature (chatbot, AI Recommender, AI Planner, Explore Mode overview,
# packing assistant, image analyzer) silently falls back to canned, non-AI text.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (macOS/Linux)
#
# .env is ignored by git and blocked from the web by .htaccess — never commit it.
# ────────────────────────────────────────────────────────────────────────────

# ── Payments (all optional -- sandbox is used automatically until these are set) ──
# PaymentService always uses the built-in Sandbox provider (no real money,
# clearly labeled everywhere) unless a real provider below has ALL of its
# required keys filled in. Leaving everything blank is completely safe and
# is the current, honest state of this project (no merchant account with
# any of these providers exists yet). See PAYMENTS.md before filling these in.
PAYMENT_PROVIDER=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_LIVE=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_LIVE=false

# ── Database (REQUIRED on every host except local XAMPP) ─────────────────────
# Leave all four blank to keep using local XAMPP defaults (localhost / root /
# no password / "tms"). Any real host (shared hosting, a VPS, Oracle Cloud...)
# will give you its own MySQL host, database name, username and password —
# put those here. This is the ONLY thing that has to change to move this app
# from your computer to a live server; nothing else in the code is
# environment-specific.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# ── AI (REQUIRED for every AI feature) ─────────────────────────────────
# Round 34 (item 21): AI_PROVIDER picks which vendor AIClient talks to.
# Leave this blank (or set it to "gemini") to keep using Google Gemini exactly
# as before this setting existed -- nothing changes for an existing .env that
# doesn't set it at all. Set it to "openai" to use OpenAI (or any
# OpenAI-Chat-Completions-compatible endpoint via OPENAI_BASE_URL) instead.
# NOTE: the OpenAI path has NOT been tested against a real account in this
# project -- see includes/ai/providers/OpenAIProvider.php's verification note
# before relying on it.
AI_PROVIDER=gemini

# Free key, no credit card: https://aistudio.google.com  →  "Get API key"
# A valid key starts with "AIza". Only used when AI_PROVIDER=gemini (default).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only used when AI_PROVIDER=openai. Get a key at https://platform.openai.com.
# OPENAI_BASE_URL defaults to api.openai.com -- point it elsewhere to use an
# OpenAI-compatible third-party endpoint instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AI_MAX_TOKENS=32768
AI_CACHE_TTL=3600
AI_RATE_LIMIT=30

# ── Weather (OPTIONAL) ───────────────────────────────────────────────────────
# Leave blank and the site uses Open-Meteo, which is free and needs no key.
# Setting this switches the Weather page to OpenWeatherMap instead.
# Free key: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL=1800

# ── Maps / Places (OPTIONAL) ─────────────────────────────────────────────────
# Explore Mode works fully without these using OpenStreetMap, Overpass and OSRM.
# A Google key adds public-transport directions and richer place photos.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# ── Outgoing email (OPTIONAL) ────────────────────────────────────────────────
# With SMTP_HOST blank, the site does not send mail at all — booking
# confirmations and password resets are written to the log instead of delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=TMS Travel

# ── App ──────────────────────────────────────────────────────────────────────
# Set APP_DEBUG=false on anything public — it controls whether PHP errors are
# printed into the page (and into JSON API responses, which breaks them).
APP_DEBUG=true

# ── Database backups (item 60 -- OPTIONAL, sensible defaults work out of the box) ──
# scripts/backup_database.php dumps the database with mysqldump, encrypts the
# dump (AES-256-GCM, PHP's own openssl_encrypt -- no external openssl.exe
# needed), and writes it to backups/ (web-blocked, same .htaccess pattern as
# database/). See BACKUPS.md before relying on this for anything real.
#
# REQUIRED to actually get an encrypted backup: without this key, the script
# refuses to run rather than silently writing an unencrypted dump.
#   Generate one with:  php -r "echo bin2hex(random_bytes(32));"
BACKUP_ENCRYPTION_KEY=
# How many most-recent backups to keep locally; older ones are deleted after
# each successful run.
BACKUP_RETENTION_COUNT=14
# OPTIONAL "offsite" copy: a second folder to also write each encrypted backup
# into. Point this at a synced folder (a Dropbox/Google Drive/OneDrive desktop
# folder, a mapped network share, an external drive) to get a real offsite
# copy without needing a cloud storage API/account wired in -- this project
# has no S3/GCS credentials configured, so it does not pretend to upload
# anywhere on its own (Rule 3: no fabricated integrations). Leave blank to
# skip the offsite copy entirely (backups still work, just local-only).
BACKUP_OFFSITE_PATH=
# Only needed if mysqldump/mysql aren't on PATH -- point these at your XAMPP
# install, e.g. C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=
MYSQL_PATH=
